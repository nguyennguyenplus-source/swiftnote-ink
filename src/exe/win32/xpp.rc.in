#include "winver.h"

0 ICON "xournalpp.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION ${PROJECT_VERSION_MAJOR}, ${PROJECT_VERSION_MINOR}, ${PROJECT_VERSION_PATCH}, 0
PRODUCTVERSION ${PROJECT_VERSION_MAJOR}, ${PROJECT_VERSION_MINOR}, ${PROJECT_VERSION_PATCH}, 0
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
	BEGIN
		/* Lang = US English, Charset = Multilingual */
		BLOCK "040904E4"
		BEGIN
			VALUE "CompanyName", "Swift note Contributors (based on Xournal++)\0"
			VALUE "FileDescription", "Swift note - Handwriting & PDF Annotation\0"
			VALUE "FileVersion", "${PROJECT_VERSION}\0"
			VALUE "ProductVersion", "${PROJECT_VERSION}\0"
			VALUE "ProductName", "Swift note\0"
			VALUE "LegalCopyright", "GPL-2.0-or-later (Swift note & Xournal++ Contributors)\0"
			VALUE "LegalTrademarks", "\0"
			VALUE "Comments", "Hybrid C++20/GTK3 + Rust fork of Xournal++\0"
		END
	END

	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1252
	END
END
