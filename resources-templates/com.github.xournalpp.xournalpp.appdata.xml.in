<?xml version="1.0" encoding="UTF-8"?>
<!-- Based on upstream Xournal++ AppStream metadata (Copyright 2019 Tobias Mueller) -->
<component type="desktop">
  <id>com.github.xournalpp.xournalpp</id>
  <translation type="gettext">xournalpp</translation>
  <name>Swift note</name>
  <summary>Calm, tactile handwriting and PDF annotation</summary>
  <developer_name>Swift note Contributors (based on Xournal++)</developer_name>
  <description>
    <p>
      Swift note is an engineered hybrid C++20/GTK3 and Rust fork of Xournal++
      designed for calm, distraction-free handwriting and PDF annotation on
      Windows 10/11 and GNU/Linux (Wayland and X11), with full .xopp format
      compatibility.
    </p>
    <p>
      Key Swift note capabilities:
    </p>
    <ul>
      <li>3 switchable canvas-first layouts (Pure Top Bar, Canvas Pill, Zen Bottom Dock) with calibrated Light and Dark themes</li>
      <li>Non-destructive Blackboard mode with chroma-preserving ink inversion and dual printable/Blackboard PDF export</li>
      <li>Quick Pen Slots, Auto-Return Eraser, and Scrble Ink-style single-key customizable shortcuts</li>
      <li>Close-Up auto-advance magnified writing panel and Vietnamese diacritic-insensitive notebook library</li>
      <li>Full Xournal++ pressure-sensitive stylus, Setsquare, Compass, LaTeX, Audio, and Poppler PDF annotation engine</li>
    </ul>
  </description>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-or-later</project_license>
  <url type="bugtracker">https://github.com/nguyennguyenplus-source/swiftnote-ink/issues</url>
  <url type="homepage">https://github.com/nguyennguyenplus-source/swiftnote-ink</url>
  <branding>
    <color type="primary" scheme_preference="light">#f5f6f8</color>
    <color type="primary" scheme_preference="dark">#16181d</color>
  </branding>
  <launchable type="desktop-id">com.github.xournalpp.xournalpp.desktop</launchable>
  <provides>
    <id>xournalpp.desktop</id>
    <binary>xournalpp</binary>
    <mediatype>application/x-xojpp</mediatype>
    <mediatype>application/x-xopp</mediatype>
    <mediatype>application/x-xopt</mediatype>
  </provides>
  <content_rating type="oars-1.0" />
  <releases>
    <release date="2026-11-25" version="1.3.8+swiftnote" />
  </releases>
</component>
